      "boundElements": null,
      "updated": 1777619738438,
      "link": null,
      "locked": false,
      "text": "Jab jab state ya state ki value change hoti hai jisko\nbhi state change hona hi kehte hai. Toh jab jab ye\nstate change hoti hai tab tab useEffect hook trigger\nhota hai.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jab jab state ya state ki value change hoti hai jisko\nbhi state change hona hi kehte hai. Toh jab jab ye\nstate change hoti hai tab tab useEffect hook trigger\nhota hai.",
