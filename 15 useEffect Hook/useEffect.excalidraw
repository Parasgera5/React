      "isDeleted": false,
      "boundElements": [],
      "updated": 1777617586949,
      "link": null,
      "locked": false,
      "text": "react ki rendering process ui banane ka kaam karti hai along\nwith this we have to perform lot of tasks in parallel jaise\nki api calling, setInterval, dom manipulation.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "react ki rendering process ui banane ka kaam karti hai along\nwith this we have to perform lot of tasks in parallel jaise\nki api calling, setInterval, dom manipulation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
