    {
      "id": "CWGpyPpRwiyH6c1qLEL7A",
      "type": "text",
      "x": 804.8363181336942,
      "y": -280.558963729597,
      "width": 533.9195556640625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 948888767,
      "version": 693,
      "versionNonce": 1608771025,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777619631304,
      "link": null,
      "locked": false,
      "text": "Micro Task Queue(MTQ)\njab react ka rendering process chal\nraha hota hai tab koi bhi other side\nprocess ko side stack (MTQ) mein rakh\ndete hai. Unhe run nahi karte khali rakhte\nhai. Fir jab main process of react/ui rendering\ncomplete ho jata hai tab. wo side processes ko\nchalate hai -> in side process ko jo (MTQ) mein\ndaale thee inhe wahi run karte hai main area pe nahi.\nThis is MTQ and how side processes are being tackled\nin react.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Micro Task Queue(MTQ)\njab react ka rendering process chal\nraha hota hai tab koi bhi other side\nprocess ko side stack (MTQ) mein rakh\ndete hai. Unhe run nahi karte khali rakhte\nhai. Fir jab main process of react/ui rendering\ncomplete ho jata hai tab. wo side processes ko\nchalate hai -> in side process ko jo (MTQ) mein\ndaale thee inhe wahi run karte hai main area pe nahi.\nThis is MTQ and how side processes are being tackled\nin react.",
      "autoResize": true,
      "lineHeight": 1.25
    },
